# =============================================================================
# Fleex GPS Tracking SaaS - Environment Configuration
# Copy to `.env` and fill secrets. Never commit `.env`.
# =============================================================================

# --- Application ---
NODE_ENV=production
APP_NAME=Fleex
APP_URL=https://fleex.mn
API_URL=https://fleex.mn/api
WEB_PORT=8080

# --- API service ---
API_PORT=3000
API_HOST=0.0.0.0
JWT_SECRET=change-me-to-a-long-random-string-min-64-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
CORS_ORIGIN=https://fleex.mn

# --- Database (PostgreSQL + TimescaleDB) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fleex
POSTGRES_USER=fleex
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql://fleex:change-me-strong-password@postgres:5432/fleex?schema=public

# PostgreSQL tuning. Compose defaults assume a 4 GB / 2 vCPU droplet
# (DO s-2vcpu-4gb), which is the production minimum after the OOM-driven
# 502s on a 2 GB host. Uncomment and raise on larger hosts.
#
# 8 GB droplet (s-4vcpu-8gb):
#   PG_SHARED_BUFFERS=2GB
#   PG_EFFECTIVE_CACHE_SIZE=6GB
#   PG_WORK_MEM=32MB
#   PG_MAINTENANCE_WORK_MEM=512MB
#   PG_MAX_CONNECTIONS=200
#   TS_TUNE_MEMORY=2GB
#   TS_TUNE_NUM_CPUS=4
#   REDIS_MAXMEMORY=1gb
#
# 16 GB / 32 GB host:
#   TS_TUNE_MEMORY=4GB  (or 8GB)
#   PG_EFFECTIVE_CACHE_SIZE=12GB (or 24GB)
#   REDIS_MAXMEMORY=2gb (or 4gb)

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379/0
# REDIS_MAXMEMORY=2gb   # default 512mb (4 GB droplet); raise on bigger hosts

# --- GPS Ingestor (Go) ---
INGESTOR_TCP_PORT=5027
INGESTOR_HEALTH_PORT=9090
INGESTOR_MAX_CONNECTIONS=20000
INGESTOR_READ_TIMEOUT_SEC=180
INGESTOR_WRITE_TIMEOUT_SEC=30

# --- WebSocket ---
WS_PATH=/ws
WS_PING_INTERVAL_MS=25000

# --- Maps ---
# When set, the web frontend defaults to Google Hybrid (satellite + labels)
# basemap on LiveMap / History / Places — required by the Oyu Tolgoi GPS
# service spec. Falls back to OpenStreetMap if left empty. The key is
# baked into the web bundle at docker build time (passed as
# VITE_GOOGLE_MAPS_API_KEY), so restrict it in Google Cloud Console to
# HTTP referrers https://fleex.mn/* + https://*.fleex.mn/* and to the
# Maps JavaScript + Maps Static APIs only.
GOOGLE_MAPS_API_KEY=

# --- Email (alerts) ---
# Two transports supported, evaluated in this order:
#
#   A) HTTPS API (preferred). Set BREVO_API_KEY to a v3 API key from
#      https://app.brevo.com/settings/keys/api . Uses port 443 — works
#      through firewalls that block outbound SMTP. Production hit
#      ETIMEDOUT on 587, switching to the HTTPS API fixed it.
#   B) SMTP (fallback). Set SMTP_HOST/USER/PASS instead. SMTP_PASS must
#      be an *SMTP key* (https://app.brevo.com/settings/keys/smtp),
#      NOT the Brevo login password.
#
# Either way, SMTP_FROM is required and its domain must be verified
# in Brevo (Senders, Domains & Dedicated IPs → Domains).
BREVO_API_KEY=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Fleet Flexible <noreply@fleex.mn>"
SMTP_REPLY_TO=

# --- SMS (MessagePro / CallPro) ---
# Provider docs: https://api.messagepro.mn/send (HTTP GET, x-api-key header,
# 5 req/sec throttle). SMS_FROM is the special short number assigned by
# CallPro. Leave SMS_PROVIDER unset to disable SMS dispatch entirely.
SMS_PROVIDER=messagepro
SMS_API_KEY=
SMS_FROM=

# --- Observability ---
LOG_LEVEL=info
SENTRY_DSN=

# --- Admin bootstrap (only used on first run) ---
BOOTSTRAP_ADMIN_EMAIL=admin@fleex.mn
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeOnFirstLogin!
BOOTSTRAP_ADMIN_COMPANY=Fleex

# --- Demo tenants (NOMIN MOTOR, OYU TOLGOI) ---
# Set to "true" to idempotently create demo companies and one COMPANY_ADMIN
# per tenant on next API boot. Safe to leave on (upserts), or unset once
# the demo accounts exist. Default password applies only on first create —
# rotating SEED_DEMO_PASSWORD does NOT change existing user passwords.
SEED_DEMO_COMPANIES=false
SEED_DEMO_PASSWORD=Fleex@2026
