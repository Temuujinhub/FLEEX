# =============================================================================
# Fleex GPS Tracking SaaS - Environment Configuration
# Copy to `.env` and fill secrets. Never commit `.env`.
# =============================================================================

# --- Application ---
NODE_ENV=production
APP_NAME=Fleex
APP_URL=https://fleex.mn
API_URL=https://fleex.mn/api
WEB_PORT=8080

# --- API service ---
API_PORT=3000
API_HOST=0.0.0.0
JWT_SECRET=change-me-to-a-long-random-string-min-64-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
CORS_ORIGIN=https://fleex.mn

# --- Database (PostgreSQL + TimescaleDB) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fleex
POSTGRES_USER=fleex
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql://fleex:change-me-strong-password@postgres:5432/fleex?schema=public

# PostgreSQL tuning. Compose defaults assume a 4 GB / 2 vCPU droplet
# (DO s-2vcpu-4gb), which is the production minimum after the OOM-driven
# 502s on a 2 GB host. Uncomment and raise on larger hosts.
#
# 8 GB droplet (s-4vcpu-8gb):
#   PG_SHARED_BUFFERS=2GB
#   PG_EFFECTIVE_CACHE_SIZE=6GB
#   PG_WORK_MEM=32MB
#   PG_MAINTENANCE_WORK_MEM=512MB
#   PG_MAX_CONNECTIONS=200
#   TS_TUNE_MEMORY=2GB
#   TS_TUNE_NUM_CPUS=4
#   REDIS_MAXMEMORY=1gb
#
# 16 GB / 32 GB host:
#   TS_TUNE_MEMORY=4GB  (or 8GB)
#   PG_EFFECTIVE_CACHE_SIZE=12GB (or 24GB)
#   REDIS_MAXMEMORY=2gb (or 4gb)

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379/0
# REDIS_MAXMEMORY=2gb   # default 512mb (4 GB droplet); raise on bigger hosts

# --- GPS Ingestor (Go) ---
INGESTOR_TCP_PORT=5027
# Public host customers program into their GPS trackers (shown in the device
# onboarding wizard). Defaults to the APP_URL hostname, then "fleex.mn".
# ONBOARDING_SERVER_HOST=gps.fleex.mn

# --- Per-plan data retention (DESTRUCTIVE — keep dry-run until infra ready) ---
# Trims each managed tenant's position history to its plan window (starter 180d,
# business/pro 365d, enterprise 730d). DRY-RUN by default: the daily 03:00 job
# only logs what WOULD be deleted. Flip to "on" ONLY after confirming backups
# and disk. To honour enterprise's 730d, also raise the global TimescaleDB
# retention policy (prisma/timescale-init.sql) from 395d to 730d.
# RETENTION_ENFORCE=on
# Safety floor — never trim newer than this many days regardless of plan.
RETENTION_FLOOR_DAYS=30
INGESTOR_HEALTH_PORT=9090
# Each live device connection costs ~20-40 KB of goroutine + buffer state, so
# 20000 conns is ~0.4-0.8 GB before GC overhead — unsafe on the 4 GB droplet
# alongside Postgres + Redis + API. 2000 covers 1000 devices plus reconnect
# headroom; raise it (e.g. 20000) only on a 32 GB host.
INGESTOR_MAX_CONNECTIONS=2000
INGESTOR_READ_TIMEOUT_SEC=180
INGESTOR_WRITE_TIMEOUT_SEC=30
# In-memory ingest queue (device goroutines → batcher). Larger absorbs
# reconnect bursts at the cost of memory.
INGESTOR_QUEUE_SIZE=16384
# raw_messages debug capture: keep 1-in-N records (1 = every record). Raise to
# e.g. 50 to cut debug-table write amplification once device count climbs.
INGESTOR_RAW_SAMPLE_N=1
# Verify the CRC-16/IBM of each AVL frame. Default off: mismatches are only
# counted (fleex_ingestor_crc_errors_total). Flip to true to drop corrupted
# frames (the device re-sends) once a ~0 false-positive rate is confirmed.
INGESTOR_VERIFY_CRC=false
# Reject the IMEI handshake for devices not registered in the database, so a
# spoofed/unknown IMEI can't hold a connection or probe the fleet. Default on.
# A transient DB lookup failure fails open (accept) so a blip can't lock out
# the fleet. Set to false to revert to accept-all (legacy behaviour).
INGESTOR_REQUIRE_REGISTERED_DEVICE=true

# --- DualCam media service (Go) ---
# Speaks the Teltonika DualCam file-transfer protocol; persists captured
# photos/videos to the shared media volume and metadata to Postgres.
MEDIA_CAM_PORT=5029
MEDIA_HEALTH_PORT=9092
MEDIA_DATA_DIR=/data/media
# Retention cap PER COMPANY (oldest rows + blobs pruned beyond this) so one
# noisy tenant can't evict another's media.
MEDIA_MAX_FILES=5000
# DoS hardening (audit A1): cap concurrent connections, the byte size of a
# single reassembled file (DATA frame len is uint16, so packet count alone
# doesn't bound it), and files pulled per connection.
MEDIA_MAX_CONNECTIONS=256
MEDIA_MAX_FILE_BYTES=67108864
MEDIA_MAX_FILES_PER_SESSION=20
# When true, pull a photo on every camera connection; default false = on-demand
# only (operator requests a capture from the Camera page).
MEDIA_AUTO_PULL=false

# --- WebSocket ---
WS_PATH=/ws
WS_PING_INTERVAL_MS=25000
# Allow the legacy ?token=<JWT> query param on the WS upgrade. Default false
# (audit H4): the JWT would otherwise land in URLs / nginx access logs. Clients
# should use POST /auth/ws-ticket; the Authorization header is also accepted.
WS_ALLOW_TOKEN_QUERY=false

# --- Maps ---
# When set, the web frontend defaults to Google Hybrid (satellite + labels)
# basemap on LiveMap / History / Places — required by the Oyu Tolgoi GPS
# service spec. Falls back to OpenStreetMap if left empty. The key is
# baked into the web bundle at docker build time (passed as
# VITE_GOOGLE_MAPS_API_KEY), so restrict it in Google Cloud Console to
# HTTP referrers https://fleex.mn/* + https://*.fleex.mn/* and to the
# Maps JavaScript + Maps Static APIs only.
GOOGLE_MAPS_API_KEY=

# --- Email (alerts) ---
# Two transports supported, evaluated in this order:
#
#   A) HTTPS API (preferred). Set BREVO_API_KEY to a v3 API key from
#      https://app.brevo.com/settings/keys/api . Uses port 443 — works
#      through firewalls that block outbound SMTP. Production hit
#      ETIMEDOUT on 587, switching to the HTTPS API fixed it.
#   B) SMTP (fallback). Set SMTP_HOST/USER/PASS instead. SMTP_PASS must
#      be an *SMTP key* (https://app.brevo.com/settings/keys/smtp),
#      NOT the Brevo login password.
#
# Either way, SMTP_FROM is required and its domain must be verified
# in Brevo (Senders, Domains & Dedicated IPs → Domains).
BREVO_API_KEY=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Fleet Flexible <noreply@fleex.mn>"
SMTP_REPLY_TO=

# --- SMS (CallPro Text API) ---
# Provider docs: https://api-text.callpro.mn/v1/sms (HTTP POST JSON, x-api-key
# header). Endpoints: /send (enqueue), /:unique_id (delivery events),
# /tenant/daily?operator= (per-operator balance: skytel|mobicom|unitel).
# Segment limits: 160 chars Latin, 70 chars Cyrillic — longer messages auto-
# split server-side. SMS_FROM is the lime number assigned by CallPro
# (e.g. 72xxxxxx). SMS_BRAND is optional. Leave SMS_PROVIDER unset to
# disable SMS dispatch entirely. The legacy value 'messagepro' is accepted
# as an alias for 'callpro' so existing deployments keep working.
#
# IMPORTANT: .env parsers only treat `#` as a comment marker. Never put an
# inline note after the value on the same line — anything after `=` is
# taken as part of the value. Write notes ABOVE the line instead. Wrong:
#   SMS_FROM=72225700   ← PDF доторх дугаар
# Right:
#   # PDF доторх тусгай дугаар
#   SMS_FROM=72225700
SMS_PROVIDER=callpro
SMS_API_KEY=
SMS_FROM=
SMS_BRAND=

# --- Reverse geocoding (lat/lng → address) ---
# Nearest-Place resolution always works (internal data, no external call).
# Street-address lookup is opt-in: set GEOCODING_ENABLED=true to call an
# external geocoder (cached in Redis). For production volume, self-host
# Nominatim and point NOMINATIM_URL at it (the public server is rate-limited).
GEOCODING_ENABLED=false
NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse

# --- Observability ---
LOG_LEVEL=info
# Go services (ingestor, events-engine, media-service) log JSON by default for
# log aggregation. Set LOG_FORMAT=console for human-readable local dev output.
LOG_FORMAT=json
SENTRY_DSN=

# --- Admin bootstrap (only used on first run) ---
BOOTSTRAP_ADMIN_EMAIL=admin@fleex.mn
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeOnFirstLogin!
BOOTSTRAP_ADMIN_COMPANY=Fleex

# --- Demo tenants (NOMIN MOTOR, OYU TOLGOI) ---
# Set to "true" to idempotently create demo companies and one COMPANY_ADMIN
# per tenant on next API boot. Safe to leave on (upserts), or unset once
# the demo accounts exist. Default password applies only on first create —
# rotating SEED_DEMO_PASSWORD does NOT change existing user passwords.
SEED_DEMO_COMPANIES=false
SEED_DEMO_PASSWORD=Fleex@2026

# --- Data safety (audit A4) ---
# Allow `prisma db push` to DROP columns/tables to match the schema on API
# boot. Default off (audit H7): destructive changes are refused so a bad
# schema edit can't silently destroy production data. Only set true for an
# intentional, backed-up migration.
PRISMA_DB_PUSH_ACCEPT_DATA_LOSS=false
# Nightly Postgres backup (infra/deploy/backup.sh via the fleex-backup timer).
BACKUP_DIR=/opt/fleex/backups
BACKUP_KEEP_DAYS=14
# Optional off-host upload; the backup file path is passed as $1, e.g.
#   BACKUP_REMOTE_CMD='rclone copy "$1" spaces:fleex-backups/'
BACKUP_REMOTE_CMD=
# Optional: a SUPER_ADMIN token so the backup job also verifies the audit chain.
AUDIT_VERIFY_TOKEN=
