# =============================================================================
# Fleex GPS Tracking SaaS - Environment Configuration
# Copy to `.env` and fill secrets. Never commit `.env`.
# =============================================================================

# --- Application ---
NODE_ENV=production
APP_NAME=Fleex
APP_URL=https://fleex.mn
API_URL=https://fleex.mn/api
WEB_PORT=8080

# --- API service ---
API_PORT=3000
API_HOST=0.0.0.0
JWT_SECRET=change-me-to-a-long-random-string-min-64-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
CORS_ORIGIN=https://fleex.mn

# --- Database (PostgreSQL + TimescaleDB) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fleex
POSTGRES_USER=fleex
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql://fleex:change-me-strong-password@postgres:5432/fleex?schema=public

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379/0

# --- GPS Ingestor (Go) ---
INGESTOR_TCP_PORT=5027
INGESTOR_HEALTH_PORT=9090
INGESTOR_MAX_CONNECTIONS=20000
INGESTOR_READ_TIMEOUT_SEC=180
INGESTOR_WRITE_TIMEOUT_SEC=30

# --- WebSocket ---
WS_PATH=/ws
WS_PING_INTERVAL_MS=25000

# --- Google Maps ---
GOOGLE_MAPS_API_KEY=replace-with-real-key

# --- SMTP (email alerts) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Fleex Alerts <alerts@fleex.mn>"

# --- SMS (Twilio or compatible) ---
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM=

# --- Observability ---
LOG_LEVEL=info
SENTRY_DSN=

# --- Admin bootstrap (only used on first run) ---
BOOTSTRAP_ADMIN_EMAIL=admin@fleex.mn
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeOnFirstLogin!
BOOTSTRAP_ADMIN_COMPANY=Fleex
