// Fleex GPS SaaS – data model.
// PostgreSQL with TimescaleDB extension. Raw SQL migrations under
// `prisma/migrations/` add hypertables, partitions and compression policies
// that Prisma's declarative schema can't express.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [timescaledb, pg_trgm, btree_gin, pgcrypto]
}

// ---- Tenancy & users -------------------------------------------------------

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  FLEET_MANAGER
  DISPATCHER
  DRIVER
  VIEWER
}

enum UserStatus {
  ACTIVE
  DISABLED
  LOCKED
}

model Company {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  contactEmail String?
  contactPhone String?
  timezone    String   @default("Asia/Ulaanbaatar")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  devices     Device[]
  groups      DeviceGroup[]
  garages     Garage[]
  geofences   Geofence[]
  drivers     Driver[]
  shifts      Shift[]
  places      Place[]
  serviceTasks ServiceTask[]

  sensors           Sensor[]
  healthRules       DeviceHealthRule[]
  notificationRules NotificationRule[]
  customFields      CustomField[]
  tickets           SupportTicket[]
  deviceImages      DeviceImage[]
  scheduledReports  ScheduledReport[]
  subscription         Subscription?
  subscriptionPayments SubscriptionPayment[]

  @@map("companies")
}

// ---- Billing / subscription plans ------------------------------------------
//
// The plan CATALOGUE (limits + included features per tier) lives in code
// (services/api/src/billing/plan-catalog.ts) so it can be tuned without a
// migration — like REPORT_TEMPLATES. The DB only stores which plan a company
// is on, its lifecycle status, and when the next payment is due. A monthly
// cron flips ACTIVE → PAST_DUE when currentPeriodEnd passes.

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

model Subscription {
  id          String  @id @default(uuid()) @db.Uuid
  companyId   String  @unique @db.Uuid
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Plan identifier — a key in the in-code PLAN_CATALOG (free/basic/pro/enterprise).
  planKey     String             @default("trial")
  status      SubscriptionStatus @default(TRIAL)

  startedAt       DateTime  @default(now())
  trialEndsAt     DateTime?
  // Next payment due date — when this passes the cron moves the sub to PAST_DUE.
  currentPeriodEnd DateTime?
  // Per-company override of the plan's device cap (0/null = use the plan default).
  deviceLimitOverride Int?
  notes       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("subscriptions")
}

// Manual payment ledger — a SUPER_ADMIN records a received payment, which
// extends the subscription's currentPeriodEnd. (Online gateway integration —
// QPay/etc. — is a later workstream that would write the same rows.)
model SubscriptionPayment {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planKey     String
  amount      Float    @default(0)
  currency    String   @default("MNT")
  periodStart DateTime
  periodEnd   DateTime
  method      String   @default("manual") // manual | qpay | card | bank
  reference   String?  // external txn id / receipt no
  recordedByUserId String? @db.Uuid
  createdAt   DateTime @default(now())

  @@index([companyId, createdAt])
  @@map("subscription_payments")
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  companyId     String?    @db.Uuid
  company       Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  // Optional link to a Driver record. When a DRIVER-role user is linked, the
  // API scopes their reads to that driver's assigned vehicle(s) (least
  // privilege, audit R-1). An unlinked DRIVER sees nothing — fail closed.
  driverId      String?    @db.Uuid
  driver        Driver?    @relation(fields: [driverId], references: [id], onDelete: SetNull)
  email         String     @unique
  username      String?    @unique
  passwordHash  String
  fullName      String?
  phone         String?
  role          Role       @default(VIEWER)
  status        UserStatus @default(ACTIVE)
  lastLoginAt   DateTime?
  failedLogins  Int        @default(0)
  lockedUntil   DateTime?
  mfaEnabled    Boolean    @default(false)
  mfaSecret     String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  refreshTokens RefreshToken[]
  apiKeys       ApiKey[]
  geofences     Geofence[]
  auditLogs     AuditLog[]
  sessions      Session[]
  tickets       SupportTicket[]    @relation("ticketSubmitter")
  ticketReplies SupportTicketReply[]

  @@index([companyId])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  userAgent   String?
  ipAddress   String?
  revokedAt   DateTime?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress  String?
  userAgent  String?
  startedAt  DateTime @default(now())
  endedAt    DateTime?

  @@index([userId, startedAt])
  @@map("sessions")
}

model ApiKey {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String   @unique
  prefix     String   @db.VarChar(12)
  scopes     String[]
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("api_keys")
}

// ---- Fleet -----------------------------------------------------------------

// Single-row marketing-content store for the landing page. Super admin
// edits the hero copy through Сайтын тохиргоо; the public landing page
// reads this through an unauthenticated GET. Hero image and the other
// in-page photos live in `LandingImage` (keyed table) so we can
// extend the gallery without growing this row.
model LandingSetting {
  id            Int      @id @default(1)
  heroTagline   String?
  heroSubText   String?
  // Legacy fields from when the hero image lived here. New uploads go
  // to LandingImage with key='hero'. Kept around so an old DB does not
  // need a destructive migration; treat as unused.
  imageMime     String?
  imageData     Bytes?
  updatedAt     DateTime @updatedAt
  updatedById   String?  @db.Uuid

  @@map("landing_settings")
}

// One image per slot on the public landing page (hero, about, each use
// case, etc.). Bytes live in Postgres as bytea — no S3 / volume mount.
model LandingImage {
  key         String   @id        // 'hero', 'about', 'use-case-mining', ...
  mimeType    String
  data        Bytes
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  @@map("landing_images")
}

// Vendor secrets (Brevo API key, MessagePro SMS key, …) editable from
// the System Health page so a SUPER_ADMIN can rotate keys without
// SSHing the host to edit /opt/fleex/.env. DB rows take precedence
// over the equivalent env var; missing rows fall through to .env so
// existing deployments keep working. Values are stored as-is and only
// returned masked over the API.
model IntegrationSetting {
  key         String   @id        // 'brevo_api_key', 'sms_api_key', ...
  value       String
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  @@map("integration_settings")
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  DECOMMISSIONED
}

// Mining-flavoured vehicle taxonomy. `OTHER` exists so the UI never traps
// a user when their equipment doesn't match a preset.
enum VehicleType {
  HAUL_TRUCK      // БелАЗ / CAT 793 ангиллын хэт том самосвал
  DUMP_TRUCK      // Энгийн самосвал
  EXCAVATOR       // Экскаватор
  BULLDOZER       // Бульдозер
  GRADER          // Грейдер
  WHEEL_LOADER    // Дугуйт ачигч
  CRANE           // Кран
  DRILL_RIG       // Өрөмдөгч
  FUEL_TANKER     // Шатхуун цистерн
  WATER_TANKER    // Усны цистерн
  BUS             // Автобус / зорчигчийн машин
  PICKUP          // Пикап
  VAN             // Фургон
  SEDAN           // Хөнгөн тэрэг
  TRACTOR         // Трактор
  MOTORBIKE       // Мотоцикл
  OTHER
}

enum FuelType {
  DIESEL
  GASOLINE
  LPG
  CNG
  ELECTRIC
  HYBRID
  OTHER
}

// Named point of interest the operator can drop on the map: depots,
// loading bays, refuelling stations, weighbridges, town offices, etc.
// Free-form `type` + `color` so the company picks their own vocabulary;
// `radiusM` is optional and only set when the place is treated like a
// soft geofence (the hard geofences live on the `Geofence` model).
enum PlaceType {
  DEPOT
  LOADING
  UNLOADING
  REFUEL
  WEIGHBRIDGE
  WORKSHOP
  OFFICE
  CHECKPOINT
  OTHER
}

model Place {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  type        PlaceType @default(OTHER)
  latitude    Float
  longitude   Float
  radiusM     Int?      // optional buffer; UI draws a circle when set
  address     String?
  description String?
  color       String?   // hex, drives marker / circle colour
  icon        String?   // optional icon key from the UI palette
  active      Boolean   @default(true)
  // Back-link to the CIRCLE geofence auto-created when radiusM is set.
  // The PlacesService keeps it in sync (lat/lng/radiusM -> geometry,
  // name -> name) so existing geofence enter/exit dispatch picks up the
  // place without separate plumbing.
  geofenceId  String?   @db.Uuid @unique
  geofence    Geofence? @relation(fields: [geofenceId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId])
  @@index([type])
  @@map("places")
}

// Physical parking depot / yard. A vehicle lives in one garage; a company
// can have many. Distinct from DeviceGroup (which represents organisational
// units / departments — алба нэгж).
model Garage {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  address     String?
  latitude    Float?
  longitude   Float?
  capacity    Int?     // нийт зогсоох багтаамж
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  devices     Device[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("garages")
}

model DeviceGroup {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  parentId    String?  @db.Uuid
  parent      DeviceGroup?  @relation("GroupTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    DeviceGroup[] @relation("GroupTree")
  devices     Device[]
  drivers     Driver[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@map("device_groups")
}

// Working-hours definition. Each row is a contiguous time window in
// HH:mm (start > end means the shift wraps midnight, e.g. night shift
// 22:00 → 06:00). Shifts can be nested via parentShiftId — typically a
// parent "Өглөөний ээлж" with bridade child rows underneath — so an OT
// dispatcher can roll up reports by department or drill into a specific
// crew. Hierarchy is one level deep in practice but the FK allows N.
model Shift {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @db.Uuid
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  startTime     String   // HH:mm in company TZ
  endTime       String   // HH:mm; wraps midnight when end < start
  color         String?  // hex; UI tints driver chips so dispatchers can scan at a glance
  parentShiftId String?  @db.Uuid
  parentShift   Shift?   @relation("ShiftTree", fields: [parentShiftId], references: [id], onDelete: SetNull)
  childShifts   Shift[]  @relation("ShiftTree")
  drivers       Driver[]
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@map("shifts")
}

model Device {
  id           String        @id @default(uuid()) @db.Uuid
  companyId    String        @db.Uuid
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  groupId      String?       @db.Uuid          // алба нэгж / department
  group        DeviceGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  garageId     String?       @db.Uuid          // гранж / physical depot
  garage       Garage?       @relation(fields: [garageId], references: [id], onDelete: SetNull)
  imei         String        @unique
  name         String
  model        String?
  simNumber    String?
  plateNumber  String?
  vin          String?
  status       DeviceStatus  @default(ACTIVE)

  // ── Vehicle identity ──────────────────────────────────────
  vehicleType    VehicleType? // самосвал / экскаватор / ...
  vehicleSubtype String?      // free text, e.g. "БелАЗ 75131"
  color          String?      // hex code, e.g. "#f59e0b"
  iconKey        String?      // optional override (e.g. "haul-truck-yellow")

  // ── Physical specs ────────────────────────────────────────
  chassisLengthMm Int?
  chassisWidthMm  Int?
  chassisHeightMm Int?
  payloadKg       Int?   // даац
  grossWeightKg   Int?
  seatCount       Int?   // зорчигчийн тоо
  axleCount       Int?
  wheelSize       String?
  wheelCount      Int?
  trailerPlate    String?

  // ── Fuel ──────────────────────────────────────────────────
  fuelType            FuelType?
  fuelGrade           String?  // АИ-80 / 92 / 95 / DT-Л / DT-З / ...
  tankCapacityL       Float?
  fuelConsumptionL100Km Float? // нормт зарцуулалт, литр / 100км

  // ── Insurance ─────────────────────────────────────────────
  insuranceContract1 String?
  insuranceUntil1    DateTime?
  insuranceContract2 String?
  insuranceUntil2    DateTime?

  // ── Telemetry snapshot (kept hot for UI; ingestor updates) ─
  lastSeenAt   DateTime?
  lastLat      Float?
  lastLng      Float?
  lastSpeed    Float?
  lastCourse   Float?
  lastAltitude Float?
  ignitionOn   Boolean?
  odometerKm   Float?
  engineHours  Float?
  batteryVolt  Float?
  protocol     String?       @default("teltonika")
  attributes   Json?
  driverId     String?       @db.Uuid
  driver       Driver?       @relation(fields: [driverId], references: [id], onDelete: SetNull)
  speedLimit   Float?        // km/h, per-device override
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  events       Event[]
  commands     Command[]
  serviceTasks ServiceTask[]

  sensors      Sensor[]
  rawMessages  RawMessage[]
  trips        Trip[]
  health       DeviceHealthStatus?
  gprsCounters GprsCounter[]
  images       DeviceImage[]
  scheduledReports ScheduledReport[]

  @@index([companyId])
  @@index([groupId])
  @@index([garageId])
  @@index([status])
  @@index([vehicleType])
  @@index([lastSeenAt])
  @@map("devices")
}

// ── DualCam media (camera photos / on-demand video) ─────────
// Blobs live on a shared volume (media-service writes, api streams);
// only metadata is in Postgres. Move to object storage at fleet scale.
model DeviceImage {
  id         String   @id @default(uuid()) @db.Uuid
  deviceId   String   @db.Uuid
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  companyId  String   @db.Uuid
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  imei       String
  kind       String   @default("photo") // "photo" | "video"
  fileName   String   // file name on the media volume
  size       Int      @default(0)
  trigger    String?  // capture trigger, if known
  capturedAt DateTime @default(now())

  @@index([deviceId, capturedAt(sort: Desc)])
  @@index([companyId, capturedAt(sort: Desc)])
  @@map("device_images")
}

// ── Service tasks (засвар үйлчилгээ) ────────────────────────
enum ServiceTaskStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum ServiceTaskKind {
  MAINTENANCE   // Урьдчилан сэргийлэх засвар
  REPAIR        // Засвар
  INSPECTION    // Үзлэг
  OIL_CHANGE    // Тос солилт
  TIRE          // Дугуй солилт / эргүүлэлт
  WASH          // Угаалга
  OTHER
}

model ServiceTask {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deviceId    String   @db.Uuid
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  title       String
  description String?
  kind        ServiceTaskKind   @default(MAINTENANCE)
  status      ServiceTaskStatus @default(PLANNED)
  cost        Float?
  unplanned   Boolean   @default(false)

  // Schedule (any combination — UI picks the most relevant one)
  scheduledAt          DateTime?
  scheduledOdometerKm  Float?
  scheduledEngineHours Float?
  reminderDays         Int?      // Push reminder N days before

  // Completion
  completedAt          DateTime?
  completedOdometerKm  Float?
  completedEngineHours Float?
  completionNotes      String?
  performedBy          String?   // Free-text mechanic / vendor name

  createdByUserId String? @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attachments ServiceTaskAttachment[]

  @@index([companyId])
  @@index([deviceId])
  @@index([status])
  @@index([scheduledAt])
  @@map("service_tasks")
}

// Single attachment ↔ many service tasks (in practice rarely more than a
// few photos per task). Bytes live in Postgres as bytea — keeps the
// deploy infra-free; we stream the data only when the user clicks
// "download".
model ServiceTaskAttachment {
  id            String       @id @default(uuid()) @db.Uuid
  serviceTaskId String       @db.Uuid
  serviceTask   ServiceTask  @relation(fields: [serviceTaskId], references: [id], onDelete: Cascade)
  filename      String
  mimeType      String
  sizeBytes     Int
  data          Bytes
  uploadedAt    DateTime     @default(now())

  @@index([serviceTaskId])
  @@map("service_task_attachments")
}

model Driver {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  groupId     String?  @db.Uuid                 // хэлтэс / department
  group       DeviceGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  // Working-hours assignment. Optional — drivers without a shift fall
  // into the catch-all "Хуваариагүй" bucket in the Shifts UI and
  // shift-filtered reports treat them as 24/7.
  shiftId     String?  @db.Uuid
  shift       Shift?   @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  fullName    String                              // Backwards-compatible display
  firstName   String?                             // Нэр
  lastName    String?                             // Овог
  shortName   String?                             // Товч нэр
  employeeId  String?                             // Ажилтны ID / personnel number
  rfidCard    String?  @unique
  phone       String?
  email       String?
  address     String?
  ssn         String?                             // Social security number
  avatarKey   String?                             // preset avatar id

  // Driver's licence
  licenseNo        String?
  licenseCategory  String?                        // A, B, C, D, CE, ...
  licenseIssuedAt  DateTime?
  licenseUntil     DateTime?

  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  devices     Device[]
  scores      DriverScore[]
  trips       Trip[]
  users       User[]                              // app logins linked to this driver

  @@index([companyId])
  @@index([groupId])
  @@index([employeeId])
  @@map("drivers")
}

// ---- Geofences -------------------------------------------------------------

enum GeofenceShape {
  CIRCLE
  POLYGON
}

model Geofence {
  id          String        @id @default(uuid()) @db.Uuid
  companyId   String        @db.Uuid
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId      String?       @db.Uuid
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String
  description String?
  shape       GeofenceShape
  // For CIRCLE: { lat, lng, radiusM }. For POLYGON: { points: [[lng,lat],...] }.
  geometry    Json
  // Day-window default speed limit, retained for backward compat. The
  // events engine combines this with the optional night override below
  // — if speedLimitNight is set and the device's clock falls in the
  // [nightStart, nightEnd) window (HH:mm, in the company timezone),
  // the night number is used instead. nightStart > nightEnd means the
  // window crosses midnight (e.g. 22:00 → 06:00).
  speedLimit       Float?
  speedLimitNight  Float?
  nightStart       String?  // HH:mm
  nightEnd         String?  // HH:mm
  active      Boolean       @default(true)
  alertOnEnter Boolean      @default(true)
  alertOnExit  Boolean      @default(true)
  // Auto-managed reverse link when the geofence was spawned from a
  // Place row. Lets the dispatcher tag GEOFENCE_ENTER/EXIT events with
  // the originating placeId so Place-scoped rules can match.
  place        Place?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  events      Event[]

  @@index([companyId])
  @@map("geofences")
}

// ---- Events & commands ------------------------------------------------------

enum EventType {
  PANIC
  OVERSPEED
  HARSH_ACCEL
  HARSH_BRAKE
  HARSH_CORNER
  GEOFENCE_ENTER
  GEOFENCE_EXIT
  IGNITION_ON
  IGNITION_OFF
  IDLE_START
  IDLE_END
  POWER_CUT
  LOW_BATTERY
  DEVICE_OFFLINE
  DEVICE_ONLINE
  TAMPER
  // Driver was last seen 2h+ ago, or last position was stationary for
  // 2h+ during a working shift. Fired by the LoneWorker safety service
  // so a manager can escalate manually.
  LONE_WORKER_RISK
  // Fuel analytics (R2): a sudden rise in fuel level (refuelling) or a sudden
  // drop (drain / possible theft), detected from the FUEL_LEVEL sensor series.
  FUEL_FILL
  FUEL_DRAIN
  CUSTOM
}

enum EventSeverity {
  INFO
  WARNING
  CRITICAL
}

model Event {
  id         BigInt        @id @default(autoincrement())
  companyId  String        @db.Uuid
  deviceId   String        @db.Uuid
  device     Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  geofenceId String?       @db.Uuid
  geofence   Geofence?     @relation(fields: [geofenceId], references: [id], onDelete: SetNull)
  type       EventType
  severity   EventSeverity @default(WARNING)
  lat        Float?
  lng        Float?
  speed      Float?
  message    String?
  payload    Json?
  acknowledged Boolean     @default(false)
  acknowledgedById String? @db.Uuid
  acknowledgedAt   DateTime?
  occurredAt DateTime
  createdAt  DateTime      @default(now())

  @@index([companyId, occurredAt])
  @@index([deviceId, occurredAt])
  @@index([type, occurredAt])
  @@index([acknowledged])
  @@map("events")
}

enum CommandStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

model Command {
  id          BigInt        @id @default(autoincrement())
  deviceId    String        @db.Uuid
  device      Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  issuedById  String        @db.Uuid
  type        String        // e.g. "reset", "setodometer", "engine_block"
  payload     Json?
  status      CommandStatus @default(PENDING)
  result      String?
  attempts    Int           @default(0)
  sentAt      DateTime?
  deliveredAt DateTime?
  createdAt   DateTime      @default(now())

  @@index([deviceId, status])
  @@map("commands")
}

// ---- Audit log (tamper-evident hash chain) ---------------------------------

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  occurredAt  DateTime @default(now())
  actorId     String?  @db.Uuid
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail  String?
  companyId   String?  @db.Uuid
  action      String   // e.g. "user.login", "device.update", "geofence.delete"
  resourceType String?
  resourceId  String?
  ipAddress   String?
  userAgent   String?
  before      Json?
  after       Json?
  metadata    Json?
  outcome     String   @default("success") // success | failure | denied
  prevHash    String   @db.VarChar(64)
  hash        String   @db.VarChar(64)

  @@index([companyId, occurredAt])
  @@index([actorId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_logs")
}

// ---- Positions (hypertable; declared so prisma db push doesn't drop it) ----
//
// The `positions` table is created by `prisma/timescale-init.sql` (which
// TimescaleInitService runs at boot) and turned into a TimescaleDB
// hypertable with monthly chunks, compression after 7 days, retention at
// 13 months, and a `positions_daily` continuous aggregate built on top.
//
// Previously this model was deliberately omitted from schema.prisma so
// Prisma "wouldn't touch" the hypertable — but `prisma db push` then saw
// the table in the DB without a matching model and tried to DROP it on
// every boot. Postgres refused because the continuous aggregate's
// dependent views (`_timescaledb_internal._partial_view_3` / `_direct_view_3`)
// were holding it. The container crashed in a restart loop.
//
// We declare the table here purely so prisma's diff is empty and it
// stops trying to drop the table. `@@ignore` keeps the model out of the
// generated Prisma Client — the ingestor and reports code paths use raw
// SQL (`$executeRaw` / `$queryRaw`) for performance anyway.
model Position {
  time         DateTime @db.Timestamptz(6)
  deviceId     String   @map("device_id") @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  latitude     Float    @db.DoublePrecision
  longitude    Float    @db.DoublePrecision
  speed        Float?   @db.Real
  course       Float?   @db.Real
  altitude     Float?   @db.Real
  satellites   Int?     @db.SmallInt
  hdop         Float?   @db.Real
  ignition     Boolean?
  odometerKm   Float?   @map("odometer_km")  @db.DoublePrecision
  engineHours  Float?   @map("engine_hours") @db.DoublePrecision
  batteryVolt  Float?   @map("battery_volt") @db.Real
  fuelPct      Float?   @map("fuel_pct")     @db.Real
  rfid         String?
  valid        Boolean  @default(true)
  attributes   Json?
  receivedAt   DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@id([deviceId, time])
  @@index([deviceId, time(sort: Desc)], map: "positions_device_time_desc")
  @@index([companyId, time(sort: Desc)], map: "positions_company_time_desc")
  @@index([attributes(ops: JsonbPathOps)], type: Gin, map: "positions_attributes_gin")
  @@map("positions")
  @@ignore
}

// ---- Sensors (logical mapping of raw IO parameters) ------------------------
//
// GPS hardware sends a fixed catalogue of raw IO IDs (Teltonika AVL IDs,
// Queclink parameter codes, etc.). A `Sensor` is the company-side
// definition that turns one of those raw fields into a named, calibrated
// value the rest of the system can reason about (fuel level, voltage,
// door open, RFID tag, ...). `sourceParam` is the protocol-level key
// (e.g. "io.239" for Teltonika ignition, "io.66" for external voltage).
// `multiplier` / `offset` are the default linear calibration; richer
// piecewise calibration goes in `calibration` (JSON: [{raw, real}, ...]).

enum SensorType {
  IGNITION
  FUEL_LEVEL
  VOLTAGE
  TEMPERATURE
  DOOR
  ENGINE_RPM
  ODOMETER
  ENGINE_HOURS
  WEIGHT
  PRESSURE
  DRIVER_RFID
  CUSTOM_DIGITAL
  CUSTOM_ANALOG
}

enum SensorValueKind {
  BOOL
  NUMBER
  TEXT
}

model Sensor {
  id            String          @id @default(uuid()) @db.Uuid
  companyId     String          @db.Uuid
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deviceId      String          @db.Uuid
  device        Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  name          String
  type          SensorType
  valueKind     SensorValueKind @default(NUMBER)
  sourceParam   String          // protocol IO key, e.g. "io.239", "io.66"
  unit          String?         // V, %, L, °C
  multiplier    Float           @default(1.0)
  offset        Float           @default(0.0)
  calibration   Json?           // optional piecewise lookup
  invert        Boolean         @default(false)
  active        Boolean         @default(true)
  // Cached last value snapshot — updated by the ingestor / events engine.
  lastValue     Float?
  lastBool      Boolean?
  lastText      String?
  lastAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([companyId])
  @@index([deviceId])
  @@map("sensors")
}

// ---- Raw messages (debug viewer) -------------------------------------------
//
// Last ~500 raw packets per device, written by the ingestor. Used by the
// "Мессеж" page to debug "why is this device not reporting" or "is the
// fuel sensor wiring right?" without leaving the operator UI. A periodic
// cleanup job trims older rows to keep the table bounded.

model RawMessage {
  id           BigInt    @id @default(autoincrement())
  deviceId     String    @db.Uuid
  device       Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  receivedAt   DateTime  @default(now())
  protocol     String
  lat          Float?
  lng          Float?
  speed        Float?
  ignition     Boolean?
  payload      Json
  byteSize     Int       @default(0)

  @@index([deviceId, receivedAt(sort: Desc)])
  @@map("raw_messages")
}

// ---- Trips -----------------------------------------------------------------
//
// A trip = engine-on → engine-off (or movement → idle, configurable).
// Aggregated by a background worker so reports (mileage, fuel, driver
// behaviour) can be computed by trip rather than across raw positions.

enum TripStatus {
  IN_PROGRESS
  COMPLETED
}

model Trip {
  id              String     @id @default(uuid()) @db.Uuid
  companyId       String     @db.Uuid
  deviceId        String     @db.Uuid
  device          Device     @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  driverId        String?    @db.Uuid
  driver          Driver?    @relation(fields: [driverId], references: [id], onDelete: SetNull)
  startedAt       DateTime
  endedAt         DateTime?
  startLat        Float
  startLng        Float
  startAddress    String?
  endLat          Float?
  endLng          Float?
  endAddress      String?
  distanceKm      Float      @default(0)
  durationS       Int        @default(0)
  maxSpeed        Float?
  avgSpeed        Float?
  fuelUsedL       Float?
  status          TripStatus @default(IN_PROGRESS)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([companyId, startedAt(sort: Desc)])
  @@index([deviceId, startedAt(sort: Desc)])
  @@map("trips")
}

// Scheduled report subscription (R1). A cron generates the chosen report
// template for the cadence's period and emails it to `recipients`. Per-device
// for now (matches the template export signature); group/fleet is a follow-up.
enum ReportCadence {
  DAILY
  WEEKLY
  MONTHLY
}

model ScheduledReport {
  id         String        @id @default(uuid()) @db.Uuid
  companyId  String        @db.Uuid
  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  templateId String                              // a REPORT_TEMPLATES key
  deviceId   String?       @db.Uuid
  device     Device?       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  cadence    ReportCadence
  format     String        @default("excel")     // excel | pdf
  recipients String[]                            // email addresses
  active     Boolean       @default(true)
  lastRunAt  DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([companyId])
  @@index([active])
  @@map("scheduled_reports")
}

// ---- Device health ---------------------------------------------------------
//
// Rule-based health checks evaluated by the events engine on a schedule.
// Each device gets a single `DeviceHealthStatus` row that holds the latest
// summary; the UI groups devices by `state` for the dashboard donut.

enum DeviceHealthState {
  HEALTHY
  WARNING
  UNHEALTHY
  UNKNOWN
}

model DeviceHealthRule {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @db.Uuid
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  // Supported `check` values:
  //   OFFLINE_GT     — minutes since lastSeen exceeds threshold
  //   VOLTAGE_LT     — batteryVolt < threshold
  //   GPS_FIX_LT     — satellites < threshold
  //   IGNITION_STALE — hours since ignitionOn flipped > threshold
  check         String
  threshold     Float
  severity      String   @default("WARNING")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId])
  @@map("device_health_rules")
}

model DeviceHealthStatus {
  deviceId     String            @id @db.Uuid
  device       Device            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  state        DeviceHealthState @default(UNKNOWN)
  diagnoses    Json?             // [{rule, message, since}, ...]
  evaluatedAt  DateTime          @default(now())

  @@map("device_health_status")
}

// ---- Driver scoring --------------------------------------------------------
//
// One aggregate row per driver per day. The events engine increments
// counters as harsh / speeding events are produced, then a nightly job
// computes the 0-100 score (100 - penalty per event-type * count).

model DriverScore {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @db.Uuid
  driverId        String   @db.Uuid
  driver          Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  date            DateTime @db.Date
  distanceKm      Float    @default(0)
  durationS       Int      @default(0)
  harshAccel      Int      @default(0)
  harshBrake      Int      @default(0)
  harshCorner     Int      @default(0)
  speedingEvents  Int      @default(0)
  idleS           Int      @default(0)
  score           Float    @default(100)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([driverId, date])
  @@index([companyId, date])
  @@map("driver_scores")
}

// ---- Notification rules ---------------------------------------------------
//
// User-defined rules that map matching events → delivery channels. The
// events engine evaluates rules whenever it inserts an `Event` and queues
// deliveries (email / sms / webhook) via the worker.

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WEBHOOK
  TELEGRAM
  PUSH
  WHATSAPP
  VIBER
}

model NotificationRule {
  id              String                @id @default(uuid()) @db.Uuid
  companyId       String                @db.Uuid
  company         Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  triggerType     EventType
  deviceIds       String[]              @db.Uuid
  groupIds        String[]              @db.Uuid
  geofenceIds     String[]              @db.Uuid
  // Empty array = any place. Non-empty restricts the rule to
  // GEOFENCE_ENTER/EXIT events whose underlying geofence is the auto-
  // managed one for a listed place. Pairs with Place.geofenceId.
  placeIds        String[]              @db.Uuid
  minSeverity     String                @default("INFO")
  channels        NotificationChannel[]
  recipientEmails String[]
  recipientPhones String[]
  // Per-channel recipient lists for the chat/push integrations. Telegram =
  // chat IDs, Push = device/FCM tokens, WhatsApp = E.164 numbers, Viber =
  // subscriber receiver IDs. Vendor credentials live in IntegrationSetting.
  recipientTelegram String[]
  recipientPush     String[]
  recipientWhatsapp String[]
  recipientViber    String[]
  webhookUrl      String?
  template        String                @default("{DEVICE}: {TYPE} at {LOCATION} ({TIME})")
  active          Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([companyId])
  @@index([triggerType])
  @@map("notification_rules")
}

// ---- Custom fields --------------------------------------------------------
//
// Per-tenant extension of the Device entity (later other entities). The
// Devices modal renders a "Custom" tab that lists each definition and the
// matching value stored in CustomFieldValue.

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
}

model CustomField {
  id           String          @id @default(uuid()) @db.Uuid
  companyId    String          @db.Uuid
  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entity       String          @default("device")
  name         String
  label        String
  type         CustomFieldType @default(TEXT)
  options      String[]
  required     Boolean         @default(false)
  ordering     Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  values       CustomFieldValue[]

  @@unique([companyId, entity, name])
  @@map("custom_fields")
}

model CustomFieldValue {
  id           String       @id @default(uuid()) @db.Uuid
  fieldId      String       @db.Uuid
  field        CustomField  @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  entityId     String       @db.Uuid
  valueText    String?

  @@unique([fieldId, entityId])
  @@index([entityId])
  @@map("custom_field_values")
}

// ---- GPRS data usage ------------------------------------------------------
//
// Per-device monthly counter of bytes sent / received over GPRS and the
// number of packets. Helps operators predict SIM-plan overages.

model GprsCounter {
  id           String    @id @default(uuid()) @db.Uuid
  deviceId     String    @db.Uuid
  device       Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  yearMonth    String    @db.VarChar(7)  // "2026-05"
  bytesRx      BigInt    @default(0)
  bytesTx      BigInt    @default(0)
  packetCount  Int       @default(0)
  resetAt      DateTime?

  @@unique([deviceId, yearMonth])
  @@index([yearMonth])
  @@map("gprs_counters")
}

// Support ticket inbox. Company admins file complaints / bug reports /
// repair requests from inside their tenant; admin@fleex.mn (SUPER_ADMIN)
// sees the full inbox across all companies and can reply. We intentionally
// keep this lightweight (no attachments, no SLA timers) — it replaces the
// old "phone us when something's broken" loop with an auditable trail.
enum SupportTicketCategory {
  COMPLAINT       // гомдол
  BUG             // алдаа
  REPAIR_REQUEST  // засварийн хүсэлт
  OTHER           // бусад / асуулт
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model SupportTicket {
  id           String                @id @default(uuid()) @db.Uuid
  companyId    String                @db.Uuid
  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  submitterId  String                @db.Uuid
  submitter    User                  @relation("ticketSubmitter", fields: [submitterId], references: [id], onDelete: Cascade)
  category     SupportTicketCategory @default(OTHER)
  priority     SupportTicketPriority @default(NORMAL)
  status       SupportTicketStatus   @default(OPEN)
  title        String
  description  String
  contactPhone String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  resolvedAt   DateTime?

  replies      SupportTicketReply[]

  @@index([companyId, status])
  @@index([status, createdAt])
  @@map("support_tickets")
}

model SupportTicketReply {
  id        String        @id @default(uuid()) @db.Uuid
  ticketId  String        @db.Uuid
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String        @db.Uuid
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
  @@map("support_ticket_replies")
}
